# Copy to .env (never commit .env). Any OpenAI-compatible endpoint works.
# Local Ollama:   EVAL_BASE_URL=http://localhost:11434/v1   EVAL_MODEL=qwen2.5:7b   (no key needed)
# Hosted API:     EVAL_BASE_URL=https://api.openai.com/v1   EVAL_MODEL=<model>       EVAL_API_KEY=<key>
EVAL_BASE_URL=http://localhost:11434/v1
EVAL_MODEL=qwen2.5:7b
EVAL_API_KEY=
